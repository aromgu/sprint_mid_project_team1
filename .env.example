# Copy to .env.local. Never commit real API keys.
OPENAI_API_KEY=
GEMINI_API_KEY=
RAG_OPENAI_FALLBACK=true
RAG_WORKSPACE_LLM_PROVIDER=openai
RAG_LLM_PROVIDER=openai
# false면 실행 준비·요구사항 카드를 검색 근거로 즉시 생성합니다.
RAG_WORKSPACE_ENRICH_CARDS=false

WANDB_API_KEY=
# Use a separate project under the same W&B account/team.
WANDB_PROJECT=rfp-action-copilot-local
# Optional team or username. Leave empty to use the API key's default entity.
WANDB_ENTITY=
WANDB_TAGS=local,rag
